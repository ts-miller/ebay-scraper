{
  "manifest_version": 3,
  "name": "eBay Search Exporter",
  "version": "1.0",
  "description": "Extracts eBay search results to JSON.",
  "permissions": ["activeTab", "downloads", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export eBay Results"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.ca/*", "*://*.ebay.de/*", "*://*.ebay.com.au/*"],
      "js": ["content.js"]
    }
  ]
}